# API the web app talks to. Local Laravel by default; api-dev for staging builds.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google sign-in: the same Web OAuth client id as the API's GOOGLE_SERVER_CLIENT_ID.
# Add this site's origin (http://localhost:5174, https://app.trymakanapa.com) to the client's
# "Authorized JavaScript origins" in Google Cloud, or the button won't work.
VITE_GOOGLE_CLIENT_ID=
