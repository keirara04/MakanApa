# Reference only — enter these as Dokploy environment variables for the
# makanapa-api-staging service. Never commit real secrets to this file.

APP_NAME=MakanApa
APP_ENV=staging
APP_KEY=                          # generate once with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api-dev.hakeemiridza.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=<dokploy-postgres-host>
DB_PORT=5432
DB_DATABASE=makanapa_staging
DB_USERNAME=<secret>
DB_PASSWORD=<secret>

SESSION_DRIVER=database
# Redis, not the database: every rate-limit check and Cache::remember was a Postgres round trip.
# Add a Redis service in Dokploy and point REDIS_HOST at it.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=<dokploy-redis-host>
REDIS_PASSWORD=<secret>
REDIS_PORT=6379

# Same image, extra services: deploy it twice more with CONTAINER_ROLE=worker and
# CONTAINER_ROLE=scheduler (see docker-entrypoint.sh). Without them queued halal jobs and
# scheduled notifications never run.
CONTAINER_ROLE=web
RUN_MIGRATIONS=true

PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=<server-restricted-key>   # server key only, never bundled into the iOS app
PLACES_CACHE_HOURS=24
PLACES_DETAILS_CACHE_MINUTES=10
COMMUNITY_FEED_CACHE_SECONDS=300

# Shared place links (/p/…) and universal links. Pages stay noindex until public launch.
SHARE_PAGES_INDEXABLE=false
APPLE_APP_ID=46798S8ZQT.com.keirara.makanapa

# Mealtime nudges (opt-in, max 1/day) — needs CONTAINER_ROLE=scheduler + worker running.
MEAL_NUDGES_ENABLED=true

# Admin panel — add this as an additional domain on the same Dokploy service (same container,
# no new service). Actual DNS already has admin.hakeemiridza.com (A record, same host as
# api-dev/dokploy) — use that here, not a placeholder.
FILAMENT_DOMAIN=admin.hakeemiridza.com

# Restaurant photos must survive container redeploys — local disk does not. Point this at an
# S3-compatible bucket (e.g. DigitalOcean Spaces) before photo moderation is a real staff workflow.
RESTAURANT_PHOTOS_PUBLIC_DISK=s3
# Unmoderated uploads (incl. halal certificate photos awaiting review) — private, and just as
# redeploy-sensitive: left on `local`, every deploy wipes them before a moderator sees them.
# Use the private Spaces disk (DO_SPACES_* in .env.example), or keep `local` only with a
# persistent volume mounted at /var/www/html/storage/app.
RESTAURANT_PHOTOS_PENDING_DISK=spaces_private
AWS_ACCESS_KEY_ID=<secret>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_DEFAULT_REGION=<region>
AWS_BUCKET=<bucket>
AWS_URL=<public-bucket-url>
AWS_ENDPOINT=<spaces-endpoint>
AWS_USE_PATH_STYLE_ENDPOINT=false

# Credentials for the account handed to App Store review (App Review Information). Set these,
# then run: php artisan db:seed --class=AppReviewAccountSeeder
APP_REVIEW_EMAIL=<secret>
APP_REVIEW_PASSWORD=<secret>
