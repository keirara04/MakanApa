APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=makanapa
DB_USERNAME=user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Filament admin panel domain (e.g. admin.makanapa.com). Leave unset locally — the panel then
# falls back to path /admin on APP_URL instead of mounting at a separate host.
FILAMENT_DOMAIN=

PLACES_PROVIDER=fixture
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_HOURS=8

OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_DAILY_LIMIT=40

RECOMMENDATION_DEBUG=false

# Bundle identifier for the native Sign in with Apple flow (aud claim on identity tokens).
APPLE_CLIENT_ID=
# From an Apple Developer "Sign in with Apple" key (Certificates, Identifiers & Profiles > Keys) —
# used to sign the client_secret JWT for the authorizationCode -> refresh_token exchange.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Web-application OAuth client ID from Google Cloud Console — NOT the iOS client ID. This is
# what the iOS app's GIDServerClientID must also be set to, and what backend token verification
# checks the ID token's `aud` against.
GOOGLE_SERVER_CLIENT_ID=
