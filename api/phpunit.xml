<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Filament/Livewire page tests accumulate memory across the full suite; 128M (PHP default) is no longer enough. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="makanapa_test"/>
        <env name="DB_USERNAME" value="user"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <!-- Always fixture in tests, regardless of local .env — never hit real Google from the test suite. -->
        <env name="PLACES_PROVIDER" value="fixture"/>
        <!-- Same for photo storage: a test that forgets Storage::fake() must never write into the real
             DigitalOcean Spaces buckets (and CI has no Spaces credentials, so the write silently fails). -->
        <env name="RESTAURANT_PHOTOS_PENDING_DISK" value="local"/>
        <env name="RESTAURANT_PHOTOS_PUBLIC_DISK" value="public"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Tests never call OpenRouter for real: an empty key selects NullJudgmentEngine unless a test opts in with Http::fake(). -->
        <env name="OPENROUTER_API_KEY" value=""/>
        <env name="JUDGMENT_RETRY_BACKOFF_MS" value="0"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <!-- Makan Brain off by default so every pre-brain test keeps exercising exactly the v1 algorithm; brain tests opt in. Weather never hits the network from tests. -->
        <env name="BRAIN_ENABLED" value="false"/>
        <env name="BRAIN_WEATHER_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
